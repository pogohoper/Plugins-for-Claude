{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/check_domain.py\" \"$TOOL_INPUT_FILE_PATH\"",
            "statusMessage": "Checking domain agent territories...",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
